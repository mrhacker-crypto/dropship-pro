{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A dropshipping product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "price": { "type": "number" },
        "sourceCurrency": { "type": "string" },
        "image": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } },
        "sourceUrl": { "type": "string" },
        "markup": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "variations": { "type": "array", "items": { "$ref": "Variation" } },
        "verificationLogs": { "type": "array", "items": { "type": "string" } },
        "shippingInfo": { "type": "string" },
        "category": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "type": { "type": "string", "enum": ["dropship", "manual"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "sourceCurrency", "image", "markup", "status", "type"]
    },
    "Variation": {
      "title": "Variation",
      "description": "Product variation like size or color",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "options": { "type": "array", "items": { "$ref": "VariationOption" } }
      },
      "required": ["name", "options"]
    },
    "VariationOption": {
      "title": "VariationOption",
      "description": "An option for a variation",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "CartItem" } },
        "customer": { "$ref": "CustomerInfo" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "fulfilled", "shipped", "delivered", "cancelled"] },
        "automationStatus": { "type": "string", "enum": ["idle", "processing", "completed", "failed"] },
        "automationLog": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "stripeSessionId": { "type": "string" }
      },
      "required": ["id", "items", "customer", "total", "currency", "status", "createdAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "A product in a cart",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cartId": { "type": "string" },
        "quantity": { "type": "number" },
        "selectedVariations": { "type": "object" }
      },
      "required": ["id", "cartId", "quantity"]
    },
    "CustomerInfo": {
      "title": "CustomerInfo",
      "description": "Customer contact and shipping information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "zip": { "type": "string" }
      },
      "required": ["name", "email", "phone", "address", "city", "country"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A chat session between a buyer and the seller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTimestamp": { "type": "string" },
        "unreadCountSeller": { "type": "number" },
        "unreadCountBuyer": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "buyerId", "buyerName", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message in a chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "senderId", "text", "timestamp"]
    },
    "Review": {
      "title": "Review",
      "description": "A product review from a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["buyer", "seller", "admin", "user"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "ExchangeRates": {
      "title": "ExchangeRates",
      "description": "Live exchange rates for currency conversion",
      "type": "object",
      "properties": {
        "base": { "type": "string" },
        "rates": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["base", "rates", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of dropshipping products"
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Subcollection of reviews for a specific product."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Collection of chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Subcollection of messages for a chat"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "/settings/exchangeRates": {
      "schema": "ExchangeRates",
      "description": "Global exchange rates settings"
    }
  }
}
