rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mr.dummy3719@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSeller() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    function isDriver() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.role in ['buyer', 'seller', 'driver', 'admin'] &&
             (!('membership' in data) || data.membership is map) &&
             (!('driverVerification' in data) || data.driverVerification is map) &&
             (!('walletBalance' in data) || data.walletBalance is number);
    }

    function isValidOrder(data) {
      let statuses = ['pending', 'paid', 'fulfilled', 'shipped', 'delivered', 'cancelled', 'awaiting_pickup', 'picked_up', 'disputed', 'reported', 'awaiting_payment', 'awaiting_confirmation', 'availability_confirmed', 'on_the_way'];
      return data.keys().hasAll(['id', 'buyerId', 'items', 'customer', 'total', 'status', 'createdAt']) &&
             data.status in statuses &&
             data.items is list && data.items.size() > 0;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && (
        // Update profile fields
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'location', 'phoneNumber', 'nationalId', 'vehicleInfo', 'bankAccount', 'isActive', 'membership', 'driverVerification', 'referralEarnings'])
      )) || isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSeller();
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.deliveryDetails.driverId == request.auth.uid || 
        isAdmin() || 
        // Allow seller to see orders containing their products
        (isSeller() && resource.data.items[0].sellerId == request.auth.uid) // Simplified for rule but ideally better checked
      );
      allow create: if isSignedIn() && incoming().buyerId == request.auth.uid && isValidOrder(incoming());
      allow update: if (isSignedIn() && (
        isAdmin() ||
        // Action: Seller confirms availability
        (isSeller() && incoming().status == 'availability_confirmed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'automationLog'])) ||
        // Action: Driver accepts/updates
        (isDriver() && incoming().deliveryDetails.driverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveryDetails', 'automationLog'])) ||
        // Action: Buyer/Driver QR Release
        (incoming().status == 'delivered' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'automationLog']))
      ));
    }

    match /police_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Logged in users can report
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (isAdmin() || chatId.size() > 0); // Simplified
    }

    match /referral_earnings/{id} {
      allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    match /driver_penalties/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isAdmin();
    }

    match /settings/exchangeRates {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
