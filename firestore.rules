rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Document ID: productId
    // Fields:
    //   - id: string (required)
    //   - title: string (required)
    //   - description: string
    //   - features: list
    //   - price: number (required)
    //   - sourceCurrency: string (required)
    //   - image: string (required)
    //   - gallery: list
    //   - sourceUrl: string (required)
    //   - markup: number (required)
    //   - status: string (required, 'pending' | 'approved')
    //   - variations: list
    //   - verificationLogs: list
    //   - shippingInfo: string
    //
    // Collection: orders
    // Document ID: orderId
    // Fields:
    //   - id: string (required)
    //   - buyerId: string (required)
    //   - items: list (required)
    //   - customer: map (required)
    //   - total: number (required)
    //   - currency: string (required)
    //   - status: string (required)
    //   - automationStatus: string
    //   - automationLog: list
    //   - createdAt: string (required)
    //   - stripeSessionId: string
    //
    // Collection: users
    // Document ID: userId
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - role: string (required, 'buyer' | 'seller' | 'admin' | 'user')
    //   - createdAt: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller')) ||
          (request.auth.token.email == "mr.dummy3719@gmail.com")
        );
    }

    function isValidProduct(data) {
      return data.keys().hasOnly(['id', 'title', 'description', 'features', 'price', 'sourceCurrency', 'image', 'gallery', 'sourceUrl', 'markup', 'status', 'variations', 'verificationLogs', 'shippingInfo', 'isVerified', 'category', 'sellerId', 'sellerName', 'type', 'createdAt']) &&
             data.keys().hasAll(['id', 'title', 'price', 'sourceCurrency', 'image', 'markup', 'status', 'type']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             data.price is number && data.price >= 0 &&
             data.markup is number && data.markup >= 0 &&
             data.status in ['pending', 'approved'] &&
             data.type in ['dropship', 'manual'] &&
             (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() < 2000)) &&
             data.image is string && data.image.size() < 1000000; // Allow larger for base64 if needed, but 1MB is limit
    }

    function isValidOrder(data) {
      return data.keys().hasOnly(['id', 'buyerId', 'items', 'customer', 'total', 'currency', 'status', 'automationStatus', 'automationLog', 'createdAt', 'stripeSessionId', 'sourceCost', 'shippingCost', 'profit', 'paymentMethod']) &&
             data.keys().hasAll(['id', 'buyerId', 'items', 'customer', 'total', 'currency', 'status', 'createdAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.buyerId is string && data.buyerId.size() > 0 && data.buyerId.size() < 100 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'paid', 'fulfilled', 'shipped', 'delivered', 'cancelled'] &&
             data.customer is map &&
             data.customer.email is string &&
             data.items is list && data.items.size() > 0 && data.items.size() < 50;
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 200 &&
             data.role in ['buyer', 'seller', 'admin', 'user'] &&
             data.createdAt is string;
    }

    function isValidChat(data) {
      return data.keys().hasOnly(['id', 'buyerId', 'buyerName', 'buyerEmail', 'lastMessage', 'lastMessageTimestamp', 'unreadCountSeller', 'unreadCountBuyer', 'updatedAt']) &&
             data.keys().hasAll(['id', 'buyerId', 'buyerName', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.buyerId is string && data.buyerId.size() > 0 && data.buyerId.size() < 100 &&
             data.buyerName is string && data.buyerName.size() > 0 && data.buyerName.size() < 500;
    }

    function isValidChatMessage(data) {
      return data.keys().hasOnly(['id', 'senderId', 'senderName', 'text', 'timestamp', 'read']) &&
             data.keys().hasAll(['senderId', 'text', 'timestamp']) &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() < 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() < 10000;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
             data.id is string && data.id.size() > 0 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() < 5000 &&
             data.createdAt is string;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data) && 
                    (request.resource.data.type == 'dropship' || request.resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin() && isValidProduct(request.resource.data) &&
                    (request.resource.data.type == 'dropship' || resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin() && (resource.data.type == 'dropship' || resource.data.sellerId == request.auth.uid);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidReview(request.resource.data);
        allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      }
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.buyerId == request.auth.uid);
      allow create: if isAuthenticated() && isValidOrder(request.resource.data) && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin() && isValidOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || (isAuthenticated() && chatId == request.auth.uid);
      allow create: if isAuthenticated() && isValidChat(request.resource.data) && chatId == request.auth.uid && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && chatId == request.auth.uid && isValidChat(request.resource.data));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (isAuthenticated() && chatId == request.auth.uid);
        allow create: if (isAdmin() || (isAuthenticated() && chatId == request.auth.uid)) && isValidChatMessage(request.resource.data);
        allow update: if isAdmin() || (isAuthenticated() && chatId == request.auth.uid && isValidChatMessage(request.resource.data));
        allow delete: if isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role);
    }

    match /test/connection {
      allow read: if true;
    }

    match /settings/exchangeRates {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
